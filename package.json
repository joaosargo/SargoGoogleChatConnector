{
  "name": "google-chat-connector",
  "version": "0.1.0",
  "description": "MCP servers that let Claude Code ask team questions, post announcements and share files in Google Chat or Webex spaces, as you.",
  "type": "module",
  "private": true,
  "bin": {
    "google-chat-connector": "./dist/index.js",
    "webex-connector": "./dist/webex/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "login": "tsx src/login.ts",
    "login:webex": "tsx src/webex/login.ts",
    "start": "node dist/index.js",
    "start:webex": "node dist/webex/index.js",
    "dev": "tsx src/index.ts",
    "dev:webex": "tsx src/webex/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "google-auth-library": "^11.1.0",
    "googleapis": "^181.0.0",
    "open": "^11.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
